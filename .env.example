# ChessAcademy — environment reference
# Copy to .env.local for local dev (see .env.local.example for the minimal set).
# Verify at runtime: GET /api/health reports which of these are missing.
#
# Architecture note: nearly every query runs as the signed-in user through RLS
# (server routes use the anon key + the user's cookie session). The service-role
# key is optional and used only where there is no user to act as: webhook
# settlement and the pre-auth login-branding lookup. See SUPABASE_SERVICE_ROLE_KEY.

# ── Supabase (REQUIRED — auth, database, storage, realtime) ────────────────
# Create a project at https://supabase.com, then Settings → API.
# Migrations + buckets: see docs/SETUP.md.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Storage: the private "sources" bucket is created by migration
# 0003_knowledge_engine.sql — no env var needed.
# Realtime: uses the same Supabase credentials — no extra var.
# Email: transactional auth email (confirm/reset) is sent by Supabase Auth.
#   Production: configure custom SMTP in Supabase Dashboard → Auth → SMTP
#   (Supabase-side setting, not an app env var).

# ── Google OAuth (optional — "Continue with Google") ────────────────────────
# Configured in Supabase Dashboard → Authentication → Providers → Google
# with a Google Cloud OAuth client ID/secret. No app env var; email/password
# works without it.

# ── AI (Knowledge Engine vision + coach assistant) ──────────────────────────
# Provider is pluggable (src/lib/ai). Default: anthropic.
# PGN uploads work with NO key; PDF/image extraction and the assistant need one.
AI_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=               # https://console.anthropic.com
OPENAI_API_KEY=                  # only if AI_PROVIDER=openai

# ── Billing (provider-agnostic, src/lib/billing) ───────────────────────────
# "mock" simulates checkout + webhooks end-to-end with no external account.
# "razorpay" uses Payment Links (Indian market) — set the three keys below
# and point a Razorpay webhook (payment_link.paid, payment.captured,
# payment.failed) at <site>/api/webhooks/razorpay.
BILLING_PROVIDER=mock            # mock | razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
BILLING_WEBHOOK_SECRET=change-me # HMAC secret verifying /api/billing/webhook
# Required even with the mock provider - it also signs the mock checkout
# link's `sig`. There is no fallback: billing refuses to run without this
# set to a real value. Keep server-only.
# SUPABASE_SERVICE_ROLE_KEY=   # optional; enables webhook settlement (billing/
#   failures) and per-tenant login branding (src/lib/branding.ts). Server-only.
#   Unset → those features degrade gracefully (login shows the generic brand).

# ── Site URL (SEO: canonical/OpenGraph/sitemap absolute URLs) ───────────────
# Set to the deployed origin in production, e.g. https://chessacademy.example
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Jitsi video (live classroom) ────────────────────────────────────────────
# Default meet.jit.si (free). Point at your own Jitsi/JaaS domain to self-host.
NEXT_PUBLIC_JITSI_DOMAIN=meet.jit.si

# ── Analytics / Monitoring / Feature flags (future — no SDK shipped yet) ────
# Classified Future in enterprise_system_architecture.md; reserved names so deploys can set them
# ahead of the integration landing:
# NEXT_PUBLIC_POSTHOG_KEY=       # product analytics + feedback widget
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# SENTRY_DSN=                    # error monitoring
# NEXT_PUBLIC_FEATURE_FLAGS=     # comma-separated flag names, e.g. "pvp"

# ── Classroom video (self-hosted LiveKit) ────────────────────────────────────
# LiveKit is an SFU: each participant publishes once and the server fans out,
# instead of the old N-to-N mesh. Self-hosting means no per-minute vendor bill —
# you pay only for the box it runs on. Run it with:
#
#   docker run --rm --network host \
#     -v $PWD/livekit.yaml:/etc/livekit.yaml \
#     livekit/livekit-server --config /etc/livekit.yaml
#
# livekit.yaml needs a `keys:` entry whose key/secret match the two below.
#
# The URL is the client-facing WebSocket (ws:// locally, wss:// in production).
# The API key/secret are SERVER-ONLY: they sign room tokens and must never be
# exposed to the browser, which is why they carry no NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── n8n failure/fallback (WhatsApp delivery of the fallback meeting link) ────
# TeleCRM owns lead acquisition; n8n's job here is the failure path only.
# POST /api/failures/classroom records the failure, resolves the class's
# fallback meeting link, and hands the session details to this webhook, which
# delivers the link to the parent/student over WhatsApp.
#
# Unset = failures are still recorded and surfaced on the CEO dashboard, and
# the endpoint reports "not_configured". It never claims a message was sent.
# The WhatsApp provider credentials (Twilio / Meta Cloud API / Gupshup) live in
# the n8n workflow, not here.
N8N_FALLBACK_WEBHOOK_URL=
N8N_FALLBACK_WEBHOOK_TOKEN=
