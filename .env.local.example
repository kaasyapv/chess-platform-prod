# Minimal local-dev env — copy to .env.local and fill in.
# Full reference with all optional vars: .env.example

# Required (auth + data): Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Optional: enables PDF/image extraction + AI assistant
# (PGN uploads and everything else work without it)
ANTHROPIC_API_KEY=
