{
  "name": "chess-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "rm -rf .next && next dev",
    "clean": "rm -rf .next tsconfig.tsbuildinfo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "db:start": "npx supabase start",
    "db:push": "npx supabase db push",
    "db:reset": "npx supabase db reset",
    "db:verify-rls": "psql \"$DATABASE_URL\" -f scripts/verify-rls.sql",
    "security:scan": "node scripts/security-scan.mjs",
    "seed:puzzles": "node scripts/seed-puzzles.mjs",
    "seed:pgns": "node scripts/ingest-pgns.mjs",
    "seed:content": "node scripts/seed-puzzles.mjs && node scripts/ingest-pgns.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@livekit/components-react": "^2.9.23",
    "@livekit/components-styles": "^1.2.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.42.2",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "lucide-react": "^1.23.0",
    "next": "16.2.10",
    "pdfjs-dist": "^6.2.108",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
