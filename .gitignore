# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real values stay local; the *.example templates are committed
.env*
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scraped reference material (reports, screenshots, walkthrough GIFs) — working
# notes, not source. Kept on disk, out of git history.
Clone_reference/
keys.txt

# Reference-architecture teardown + upgrade dossier: audit notes, spec docs,
# reverse-engineering artifacts (minified third-party bundles), screenshots.
# Working material, not application source — kept on disk, out of git history
# and out of the Vercel deploy.
final_boss_implement/

# Reference corpus (chess book PDFs, raw PGN dumps). ~480MB of binaries that
# never change and are not source. Tracking them made every commit repack a
# 370MB loose-object store, which is what made the editor stall. Kept on disk.
Data/

# Supabase CLI local artifacts (start-secrets holds local dev keys; version
# markers churn on every CLI run). cli-latest stays tracked.
supabase/.temp/*
!supabase/.temp/cli-latest

# Local-only working material — planning notes, session trackers, AI agent
